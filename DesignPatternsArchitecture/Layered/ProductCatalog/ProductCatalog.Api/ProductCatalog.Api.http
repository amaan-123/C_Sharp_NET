# "name": "Phone",
# "price": 35000,
# "stock": 11,
# "category": "Electronics"
# }
{
"name": "Laptop",
"price": 75000,
"stock": 5,
"category": "Electronics"
}

###
PUT {{ProductCatalog.Api_HostAddress}}/api/products/2
Content-Type: application/json
{
"name": "Samsung Note X",
"price": 175000,
"stock": 2,
"category": "Electronics"
}

###

DELETE {{ProductCatalog.Api_HostAddress}}/api/products/2
Accept: application/json

